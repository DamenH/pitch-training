{
  "name": "pitch-training",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first absolute pitch training: identify and sing notes, entirely in the browser.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "node scripts/build-single.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm run test && npm run build",
    "test:pwa": "npm run build && npm run build:single && node scripts/verify-pwa.mjs",
    "benchmark:links": "vitest run tests/share-size.test.ts --reporter=verbose --disableConsoleIntercept"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "fflate": "^0.8.3",
    "pitchy": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

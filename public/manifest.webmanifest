{
  "name": "Pitch Training",
  "short_name": "Pitch",
  "description": "Practise identifying and singing musical notes, entirely in your browser.",
  "start_url": "./",
  "id": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f7f6f2",
  "theme_color": "#f7f6f2",
  "categories": ["music", "education"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Identify", "short_name": "Identify", "url": "./#/identify" },
    { "name": "Sing", "short_name": "Sing", "url": "./#/sing-practice" },
    { "name": "Sing test", "short_name": "Test", "url": "./#/sing-test" },
    { "name": "Reference", "short_name": "Reference", "url": "./#/reference" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "audio/midi": [".mid", ".midi"],
        "application/json": [".json"]
      }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "file", "accept": ["audio/midi", "audio/x-midi", ".mid", ".midi", "application/json", ".json"] }]
    }
  },
  "launch_handler": { "client_mode": "focus-existing" }
}
